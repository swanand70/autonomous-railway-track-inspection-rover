        </visual>

      </link>
    </model>

    <!-- ==================== WORLD END ==================== -->

  
    


    <!-- ==================== GUI CAMERA VIEW ==================== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-36.0 -4.5 3.2 0 0.30 0.50</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>


</sdf>
